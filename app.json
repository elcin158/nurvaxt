{
  "expo": {
    "name": "EVTAS",
    "slug": "evtas-mobile",
    "scheme": "evtas",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "az.rihis.evtas.mobile"
    },
    "android": {
      "package": "az.rihis.evtas.mobile",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#FFFFFF",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "EVTAS tətbiqini təhlükəsiz açmaq üçün Face ID istifadə olunur."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "EVTAS tətbiqini təhlükəsiz açmaq üçün Face ID istifadə olunur."
        }
      ],
      "react-native-quick-crypto",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hər addım saxlananda və əməliyyat icra ediləndə yeriniz GPS ilə qeyd olunur. Bu, sahə işinin təsdiqi üçündür."
        }
      ],
      "expo-router",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "./plugins/withReleaseSigning"
    ]
  }
}
