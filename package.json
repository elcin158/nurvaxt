{
  "name": "nurvaxt-mobile",
  "version": "1.0.9",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:clear": "expo start --dev-client --clear",
    "web": "expo start --web",
    "android": "expo run:android",
    "android:dev": "expo run:android --variant debug",
    "android:build": "cd android && ./gradlew assembleDebug",
    "prebuild": "expo prebuild",
    "lint": "eslint .",
    "format": "prettier --write app src scripts tests docs plugins *.json *.js *.ts *.md modules/nurvaxt-alarm/src modules/nurvaxt-alarm/package.json modules/nurvaxt-alarm/expo-module.config.json",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "prayer:import": "node --import tsx scripts/prayer-data-import/cli.ts import",
    "prayer:validate": "node --import tsx scripts/prayer-data-import/cli.ts validate",
    "prayer:build-db": "node --import tsx scripts/prayer-data-import/cli.ts build-db",
    "assets:generate": "node --import tsx scripts/generate-assets.ts",
    "android:smoke": "python3 scripts/android-smoke.py",
    "android:notification-smoke": "python3 scripts/android-notification-smoke.py",
    "android:countdown-smoke": "python3 scripts/android-countdown-smoke.py",
    "android:release-key": "python3 scripts/create-release-keystore.py",
    "android:release": "cd android && ./gradlew :app:assembleRelease --no-daemon --max-workers=2 -Pkotlin.compiler.execution.strategy=in-process",
    "android:bundle": "cd android && ./gradlew :app:bundleRelease --no-daemon --max-workers=2 -Pkotlin.compiler.execution.strategy=in-process",
    "prayer:candidates": "node --import tsx scripts/prayer-data-import/candidate.ts",
    "prayer:review": "node --import tsx scripts/prayer-data-import/review-candidate.ts",
    "android:regions-smoke": "python3 scripts/android-regions-smoke.py"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.104.1",
    "cheerio": "^1.2.0",
    "expo": "~55.0.31",
    "expo-asset": "~55.0.20",
    "expo-audio": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.40",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-localization": "~55.0.19",
    "expo-location": "~55.1.14",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-sensors": "~55.0.19",
    "expo-splash-screen": "~55.0.25",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "luxon": "^3.7.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "babel-preset-expo": "^55.0.25",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^55.0.1",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.22",
    "prettier": "^3.9.9",
    "react-test-renderer": "19.2.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
