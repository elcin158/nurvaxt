<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/countdown_expanded" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingTop="4dp" android:paddingBottom="4dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/countdown_prayer" style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginEnd="12dp" android:gravity="center_vertical" android:fontFamily="sans-serif-medium"
            android:textColor="@color/countdown_primary" android:textStyle="bold"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="22sp"
            android:ellipsize="end" android:includeFontPadding="false" android:maxLines="2" android:textSize="22sp" />
        <!-- maxLines constrains autosizing by width; singleLine would enable horizontal scrolling. -->
        <Chronometer android:id="@+id/countdown_timer" style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="128dp" android:layout_height="match_parent" android:gravity="center_vertical|end"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="34sp"
            android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:includeFontPadding="false"
            android:textColor="@color/countdown_primary" android:textStyle="bold"
            android:maxLines="1" android:scrollHorizontally="false"
            android:textDirection="ltr" android:textSize="34sp" />
    </LinearLayout>

    <ImageView android:id="@+id/countdown_progress" android:layout_width="match_parent"
        android:layout_height="24dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp"
        android:importantForAccessibility="no" android:scaleType="fitCenter" />

    <LinearLayout android:id="@+id/countdown_kerahat" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical"
        android:visibility="gone">
        <!-- RemoteViews permits ImageView, but not a plain View, for the divider. -->
        <ImageView android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginBottom="8dp" android:background="@drawable/nurvaxt_countdown_divider"
            android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/countdown_kerahat_label" style="@style/TextAppearance.Compat.Notification.Title"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginEnd="8dp" android:gravity="center_vertical" android:fontFamily="sans-serif-medium"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="18sp"
                android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:textSize="18sp" />
            <TextView android:id="@+id/countdown_kerahat_timer" style="@style/TextAppearance.Compat.Notification.Title"
                android:layout_width="48dp" android:layout_height="match_parent" android:gravity="center_vertical|end"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="28sp"
                android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:includeFontPadding="false"
                android:maxLines="1" android:textDirection="ltr" android:textSize="28sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
