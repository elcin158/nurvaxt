<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="48dp"
    android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/countdown_prayer" style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginEnd="12dp" android:gravity="center_vertical" android:fontFamily="sans-serif-medium"
            android:textColor="@color/countdown_primary" android:textStyle="bold"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="16sp"
            android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:textSize="16sp" />
        <Chronometer android:id="@+id/countdown_timer" style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="100dp" android:layout_height="match_parent" android:gravity="center_vertical|end"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="26sp"
            android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:includeFontPadding="false"
            android:textColor="@color/countdown_primary" android:textStyle="bold"
            android:maxLines="1" android:scrollHorizontally="false"
            android:textDirection="ltr" android:textSize="26sp" />
    </LinearLayout>

    <ImageView android:id="@+id/countdown_progress" android:layout_width="match_parent"
        android:layout_height="20dp" android:layout_marginTop="1dp"
        android:importantForAccessibility="no" android:scaleType="fitCenter" />
</LinearLayout>
