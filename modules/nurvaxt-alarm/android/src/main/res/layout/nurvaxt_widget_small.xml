<FrameLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/nurvaxt_widget_navy"
  android:clipToOutline="true"
  android:layoutDirection="ltr">
  <ImageView
    android:layout_width="160dp"
    android:layout_height="120dp"
    android:layout_gravity="top|end"
    android:src="@drawable/nurvaxt_widget_orbit"
    android:contentDescription="@null" />
  <LinearLayout
    android:id="@+id/widget_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical">
      <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/nurvaxt_widget_crescent"
        android:contentDescription="@null" />
      <TextView
        android:id="@+id/widget_location"
        style="@style/NurvaxtWidgetText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:layout_marginStart="6dp"
        android:text="@string/nurvaxt_widget_preview_city"
        android:textColor="#C7E7FF"
        android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:orientation="vertical"
      android:gravity="center_vertical">
      <TextView
        android:id="@+id/widget_prayer"
        style="@style/NurvaxtWidgetNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nurvaxt_widget_asr"
        android:textSize="29sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/widget_time"
        style="@style/NurvaxtWidgetNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nurvaxt_widget_preview_asr"
        android:textSize="23sp"
        android:layout_marginTop="2dp" />
    </LinearLayout>
    <ImageView
      android:id="@+id/widget_progress"
      android:layout_width="match_parent"
      android:layout_height="8dp"
      android:layout_marginTop="4dp"
      android:layout_marginBottom="4dp"
      android:scaleType="fitXY"
      android:contentDescription="@null" />
    <TextView
      android:id="@+id/widget_remaining"
      style="@style/NurvaxtWidgetNumber"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/nurvaxt_widget_preview_remaining"
      android:textSize="20sp"
      android:textStyle="bold" />
  </LinearLayout>
</FrameLayout>
