<FrameLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/nurvaxt_widget_blue"
  android:clipToOutline="true"
  android:layoutDirection="ltr">
  <ImageView
    android:layout_width="160dp"
    android:layout_height="120dp"
    android:layout_gravity="top|end"
    android:src="@drawable/nurvaxt_widget_orbit"
    android:contentDescription="@null" />
  <LinearLayout
    android:id="@+id/widget_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical">
      <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/nurvaxt_widget_crescent"
        android:contentDescription="@null" />
      <TextView
        android:id="@+id/widget_brand"
        style="@style/NurvaxtWidgetText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nurvaxt_widget_brand"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="6dp" />
      <TextView
        android:id="@+id/widget_location"
        style="@style/NurvaxtWidgetText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:layout_marginStart="12dp"
        android:text="@string/nurvaxt_widget_preview_city"
        android:textSize="13sp" />
    </LinearLayout>
    <TextView
      android:id="@+id/widget_date"
      style="@style/NurvaxtWidgetText"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/nurvaxt_widget_preview_date"
      android:textSize="11sp"
      android:layout_marginTop="5dp"
      android:textColor="#C1DDFA" />
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:baselineAligned="false">
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="8dp">
        <TextView
          android:id="@+id/widget_prayer"
          style="@style/NurvaxtWidgetNumber"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/nurvaxt_widget_asr"
          android:textSize="38sp"
          android:textStyle="bold" />
        <TextView
          android:id="@+id/widget_time"
          style="@style/NurvaxtWidgetNumber"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/nurvaxt_widget_preview_asr"
          android:textSize="23sp"
          android:layout_marginTop="3dp" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.1"
        android:orientation="vertical"
        android:gravity="end">
        <TextView
          android:id="@+id/widget_remaining"
          style="@style/NurvaxtWidgetNumber"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/nurvaxt_widget_preview_remaining"
          android:textSize="34sp"
          android:gravity="end"
          android:textStyle="bold" />
      </LinearLayout>
    </LinearLayout>
    <ImageView
      android:id="@+id/widget_progress"
      android:layout_width="match_parent"
      android:layout_height="8dp"
      android:layout_marginTop="4dp"
      android:layout_marginBottom="4dp"
      android:scaleType="fitXY"
      android:contentDescription="@null" />
    <LinearLayout
      android:id="@+id/widget_strip"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:baselineAligned="false">
      <LinearLayout
        android:id="@+id/widget_cell_fajr"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">
        <TextView
          android:id="@+id/widget_label_fajr"
          style="@style/NurvaxtWidgetText"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/nurvaxt_widget_fajr"
          android:textSize="10sp" />
        <TextView
          android:id="@+id/widget_value_fajr"
          style="@style/NurvaxtWidgetNumber"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/nurvaxt_widget_preview_fajr"
          android:textSize="16sp"
          android:gravity="center"
          android:layout_marginTop="4dp" />
      </LinearLayout>
      <LinearLayout
        android:id="@+id/widget_cell_dhuhr"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">
        <TextView
          android:id="@+id/widget_label_dhuhr"
          style="@style/NurvaxtWidgetText"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/nurvaxt_widget_dhuhr"
          android:textSize="10sp" />
        <TextView
          android:id="@+id/widget_value_dhuhr"
          style="@style/NurvaxtWidgetNumber"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/nurvaxt_widget_preview_dhuhr"
          android:textSize="16sp"
          android:gravity="center"
          android:layout_marginTop="4dp" />
      </LinearLayout>
      <LinearLayout
        android:id="@+id/widget_cell_asr"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:background="@drawable/nurvaxt_widget_selected">
        <TextView
          android:id="@+id/widget_label_asr"
          style="@style/NurvaxtWidgetText"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/nurvaxt_widget_asr"
          android:textSize="10sp" />
        <TextView
          android:id="@+id/widget_value_asr"
          style="@style/NurvaxtWidgetNumber"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/nurvaxt_widget_preview_asr"
          android:textSize="16sp"
          android:gravity="center"
          android:layout_marginTop="4dp" />
      </LinearLayout>
      <LinearLayout
        android:id="@+id/widget_cell_maghrib"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">
        <TextView
          android:id="@+id/widget_label_maghrib"
          style="@style/NurvaxtWidgetText"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/nurvaxt_widget_maghrib"
          android:textSize="10sp" />
        <TextView
          android:id="@+id/widget_value_maghrib"
          style="@style/NurvaxtWidgetNumber"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/nurvaxt_widget_preview_maghrib"
          android:textSize="16sp"
          android:gravity="center"
          android:layout_marginTop="4dp" />
      </LinearLayout>
      <LinearLayout
        android:id="@+id/widget_cell_isha"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">
        <TextView
          android:id="@+id/widget_label_isha"
          style="@style/NurvaxtWidgetText"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/nurvaxt_widget_isha"
          android:textSize="10sp" />
        <TextView
          android:id="@+id/widget_value_isha"
          style="@style/NurvaxtWidgetNumber"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/nurvaxt_widget_preview_isha"
          android:textSize="16sp"
          android:gravity="center"
          android:layout_marginTop="4dp" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
